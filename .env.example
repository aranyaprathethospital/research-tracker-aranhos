# Values are validated by @t3-oss/env-nextjs in config/env.ts.
# Supabase PostgreSQL: transaction pooler for runtime, session pooler for Prisma migrate
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# Private Supabase Storage for profile photos and signatures (server-only key)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="replace-with-a-server-only-secret-key"

# Better Auth (at least 32 random characters; generate locally, never commit the value)
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# MOPH ProviderID / Health ID OAuth registration
# UAT or PRD; use UAT for integration testing
MOPH_ENV="UAT"
MOPH_HEALTH_ID_CLIENT_ID="request-from-moph"
MOPH_HEALTH_ID_CLIENT_SECRET="request-from-moph"
MOPH_PROVIDER_ID_CLIENT_ID="request-from-moph"
MOPH_PROVIDER_ID_SECRET_KEY="request-from-moph"
# Must exactly match the URI registered with MOPH:
MOPH_REDIRECT_URI="http://localhost:3000/api/auth/callback/provider-id"
